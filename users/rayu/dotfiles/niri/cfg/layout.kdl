    layout {
        gaps 8 // Gap between windows
        center-focused-column "never" // Don’t auto-center focused column


        // Matches mango border_px / focus_color / border_color
        focus-ring {
            width 1
            active-color "#7aa2f7"
            inactive-color "#1a1b26"
        }

        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

        struts {}
    }
