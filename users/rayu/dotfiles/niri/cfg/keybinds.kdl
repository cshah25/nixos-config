binds {

    // ────────────── Keybindings ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings
    // Mirrors dotfiles/mango/cfg/bind.conf — keep the two in sync.

    // ─── Noctalia Shell Integration ───
    // https://docs.noctalia.dev/getting-started/keybinds/
    Mod+Ctrl+Return                     hotkey-overlay-title="App Launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Alt+L                           hotkey-overlay-title="Lock Screen" { spawn-sh "noctalia msg session lock"; }
    Mod+Escape                          hotkey-overlay-title="Lock Screen" { spawn-sh "noctalia msg session lock"; }
    Mod+Shift+Q                         hotkey-overlay-title="Control Center" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Ctrl+Alt+Delete                     hotkey-overlay-title="Control Center" { spawn-sh "noctalia msg panel-toggle control-center"; }

    // ─── Audio & Media Controls ───
    XF86AudioRaiseVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute                       allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86MonBrightnessDown               allow-when-locked=true { spawn-sh "brightnessctl s 10%-"; }
    XF86MonBrightnessUp                 allow-when-locked=true { spawn-sh "brightnessctl s +10%"; }
    XF86AudioPlay                       allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioNext                       allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPrev                       allow-when-locked=true { spawn-sh "playerctl previous"; }

    // ─── Applications ───
    Mod+Return                          hotkey-overlay-title="Terminal: Alacritty" { spawn "alacritty"; }
    Mod+B                               hotkey-overlay-title="Default Browser" { spawn-sh "xdg-open http://"; }
    Mod+C                               hotkey-overlay-title="Editor: VSCode" { spawn "code"; }
    Mod+E                               hotkey-overlay-title="File Manager: Thunar" { spawn-sh "thunar -w"; }

    // ─── Window Actions ───
    Mod+Q                               { close-window; }
    Mod+T                               { toggle-window-floating; }
    Mod+F                               { fullscreen-window; }
    Mod+W                               { toggle-column-tabbed-display; }
    // Mod+Space (switch_layout in mango) has no niri equivalent
    // Mod+R (reload_config in mango) not needed: niri reloads on save
    Mod+Shift+P                         { power-off-monitors; }

    // Super+drag to move / Super+right-drag to resize is built into niri

    // ─── Directional Focus (Arrow keys & Vim HJKL) ───
    Mod+Left                            { focus-column-left; }
    Mod+Right                           { focus-column-right; }
    Mod+Up                              { focus-window-up; }
    Mod+Down                            { focus-window-down; }
    Mod+H                               { focus-column-left; }
    Mod+L                               { focus-column-right; }
    Mod+K                               { focus-window-up; }
    Mod+J                               { focus-window-down; }
    Mod+Home                            { focus-column-left; }
    Mod+End                             { focus-column-right; }

    // ─── Window Movement / Swap (Arrow keys & Vim HJKL) ───
    Mod+Ctrl+Left                       { move-column-left; }
    Mod+Ctrl+Right                      { move-column-right; }
    Mod+Ctrl+Up                         { move-window-up; }
    Mod+Ctrl+Down                       { move-window-down; }
    Mod+Ctrl+H                          { move-column-left; }
    Mod+Ctrl+L                          { move-column-right; }
    Mod+Ctrl+K                          { move-window-up; }
    Mod+Ctrl+J                          { move-window-down; }

    // ─── Scroller: Proportions ───
    Mod+Equal                           { switch-preset-column-width; }
    Mod+Ctrl+Minus                      { set-column-width "50%"; }
    Mod+Shift+Minus                     { set-column-width "80%"; }
    Mod+Ctrl+F                          { set-column-width "100%"; }

    // ─── Monitor Focus & Movement ───
    Mod+Shift+Left                      { focus-monitor-left; }
    Mod+Shift+Right                     { focus-monitor-right; }
    Mod+Shift+Up                        { focus-monitor-up; }
    Mod+Shift+Down                      { focus-monitor-down; }
    Mod+Shift+Ctrl+Left                 { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right                { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up                   { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down                 { move-column-to-monitor-down; }

    // ─── Workspaces (1–9) ───
    Mod+1                               { focus-workspace 1; }
    Mod+2                               { focus-workspace 2; }
    Mod+3                               { focus-workspace 3; }
    Mod+4                               { focus-workspace 4; }
    Mod+5                               { focus-workspace 5; }
    Mod+6                               { focus-workspace 6; }
    Mod+7                               { focus-workspace 7; }
    Mod+8                               { focus-workspace "chat"; }
    Mod+9                               { focus-workspace "music"; }

    Mod+Ctrl+1                          { move-column-to-workspace 1; }
    Mod+Ctrl+2                          { move-column-to-workspace 2; }
    Mod+Ctrl+3                          { move-column-to-workspace 3; }
    Mod+Ctrl+4                          { move-column-to-workspace 4; }
    Mod+Ctrl+5                          { move-column-to-workspace 5; }
    Mod+Ctrl+6                          { move-column-to-workspace 6; }
    Mod+Ctrl+7                          { move-column-to-workspace 7; }
    Mod+Ctrl+8                          { move-column-to-workspace "chat"; }
    Mod+Ctrl+9                          { move-column-to-workspace "music"; }

    Mod+Tab                             { focus-workspace-previous; }

    // ─── Screenshots (Noctalia) ───
    Mod+Shift+1                         { spawn-sh "noctalia msg screenshot-region"; }
    Mod+Shift+2                         { spawn-sh "noctalia msg screenshot-fullscreen"; }
    Mod+Shift+3                         { spawn-sh "noctalia msg screenshot-fullscreen all"; }
    Mod+Shift+4                         { spawn-sh "noctalia msg screenshot-fullscreen pick"; }

    // Touchpad gestures: niri's built-in 3-finger swipes (scroll columns /
    // switch workspaces) cover mango's gesturebinds; niri can't rebind them.

    // ─── Niri-only extras (no mango equivalent, no conflicts) ───
    Mod+Shift+Escape                    { show-hotkey-overlay; }
    Mod+O                               repeat=false { toggle-overview; }
    Mod+Ctrl+C                          { center-visible-columns; }
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }
    Mod+Ctrl+Home                       { move-column-to-first; }
    Mod+Ctrl+End                        { move-column-to-last; }
    XF86PowerOff                        allow-when-locked=true { spawn-sh "noctalia msg session lock"; }

    Mod+Page_Down                       cooldown-ms=150 { focus-workspace-down; }
    Mod+Page_Up                         cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+Page_Down                  cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up                    cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+Shift+Page_Down                 { focus-column-right; }
    Mod+Shift+Page_Up                   { focus-column-left; }
    Mod+Ctrl+Shift+Page_Down            { move-column-right; }
    Mod+Ctrl+Shift+Page_Up              { move-column-left; }

    Mod+WheelScrollRight                { focus-column-right; }
    Mod+WheelScrollLeft                 { focus-column-left; }
    Mod+Ctrl+WheelScrollRight           { move-column-right; }
    Mod+Ctrl+WheelScrollLeft            { move-column-left; }

    // Emergency escape when a fullscreen app grabs all keys
    // (moved off Mod+Escape, which is lock in mango)
    Mod+Alt+Escape                      allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
